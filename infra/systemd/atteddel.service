[Unit]
Description=AttedDEL — Smart Attendance Management System
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/atteddel
EnvironmentFile=/opt/atteddel/.env
ExecStart=/opt/atteddel/.venv/bin/uvicorn backend.app.main:app --host 0.0.0.0 --port 8000 --workers 2
Restart=always
RestartSec=5
StandardOutput=append:/opt/atteddel/logs/systemd.log
StandardError=append:/opt/atteddel/logs/systemd_err.log
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target

