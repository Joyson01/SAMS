# ==============================================================================
# AttedDEL — Smart Attendance Management System - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and adjust values for your local or production environment.
# NEVER commit the actual '.env' file containing real secrets to Git.

# ------------------------------------------------------------------------------
# 1. APPLICATION METADATA & ENVIRONMENT
# ------------------------------------------------------------------------------
PROJECT_NAME="AttedDEL — Smart Attendance Management System"
APP_NAME="AttedDEL"
VERSION="1.0.0"
ENVIRONMENT="development"       # "development" | "staging" | "production"
DEBUG=true

# ------------------------------------------------------------------------------
# 2. SERVER & NETWORK BINDING
# ------------------------------------------------------------------------------
HOST="0.0.0.0"
PORT=8000
API_V1_STR="/api/v1"

# CORS Allowed Origins (Comma-separated or JSON list for frontend web/mobile clients)
CORS_ORIGINS=["http://localhost:5173","https://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# SQLite Default (Zero-configuration local development mode):
DATABASE_URL="sqlite+aiosqlite:///./data/sams_dev.db"
DATABASE_SYNC_URL="sqlite:///./data/sams_dev.db"
DATABASE_FALLBACK_SQLITE=true

# PostgreSQL Production Mode (Uncomment for production deployments):
# DATABASE_URL="postgresql+asyncpg://sams_user:sams_password@localhost:5432/sams_db"
# DATABASE_SYNC_URL="postgresql://sams_user:sams_password@localhost:5432/sams_db"

# ------------------------------------------------------------------------------
# 4. SECURITY & AUTHENTICATION
# ------------------------------------------------------------------------------
# Generate a secure 64-character random key in production: openssl rand -hex 32
SECRET_KEY="sams-development-secret-key-change-in-production-environment-2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ------------------------------------------------------------------------------
# 5. COMPUTER VISION & AI ENGINE PARAMETERS
# ------------------------------------------------------------------------------
# Face Recognition Cosine Similarity Thresholds [0.0 - 1.0]
# Values >= 0.65 are high-confidence verified matches
# Values between 0.40 - 0.64 are candidate matches
# Values < 0.40 are classified as unknown/unregistered
FACE_RECOGNITION_THRESHOLD=0.65
UNCERTAIN_LOWER_THRESHOLD=0.40
DETECTION_CONFIDENCE_THRESHOLD=0.60
LIVENESS_THRESHOLD=0.80

# Temporal Verification & Multi-frame Consensus (Video & Live Streams)
TEMPORAL_WINDOW_FRAMES=5
TEMPORAL_CONSENSUS_RATIO=0.60

# AI Execution Provider ("CPUExecutionProvider" | "CUDAExecutionProvider")
AI_PROVIDER="CPUExecutionProvider"
INSIGHTFACE_ROOT=".insightface"
MODEL_STORAGE_DIR="./ai_engine/models"

# ------------------------------------------------------------------------------
# 6. LOGGING & STORAGE DIRECTORIES
# ------------------------------------------------------------------------------
LOG_LEVEL="INFO"                # "DEBUG" | "INFO" | "WARNING" | "ERROR"
LOG_FORMAT="text"               # "text" | "json"
UPLOAD_DIRECTORY="./data/uploads"
OUTPUTS_DIRECTORY="./outputs"
