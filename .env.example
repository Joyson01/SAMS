# AttedDEL FastAPI + React development configuration
ENVIRONMENT=development
DEBUG=true
AUTH_BYPASS=false
DATABASE_URL=sqlite+aiosqlite:///./data/sams_dev.db
DATABASE_SYNC_URL=sqlite:///./data/sams_dev.db
DATABASE_FALLBACK_SQLITE=false
SQLITE_FALLBACK_URL=sqlite+aiosqlite:///./data/sams_dev.db
# Launcher replaces this with a random key when creating .env. Production rejects it.
SECRET_KEY=development-only-change-me-before-deploying
BOOTSTRAP_TOKEN=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=7
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
ENROLLMENT_REQUIRED_POSES=FRONT,LEFT_15,RIGHT_15,TILT_UP,TILT_DOWN,ROLL_RIGHT,BACKUP_FRONT
# Model files are stored by InsightFace in ~/.insightface/models/buffalo_l
ONNX_THREADS=4
AI_PROVIDER=CPUExecutionProvider
KNOWN_THRESHOLD=0.65
REVIEW_THRESHOLD=0.55
FACE_MATCH_THRESHOLD=0.65
MIN_FACE_SIZE=40
PHOTO_DET_SIZE=1280
PHOTO_TILE_SIZE=640
PHOTO_TILE_OVERLAP=0.20
PHOTO_MARGIN=0.05
FACE_RECOGNITION_THRESHOLD=0.58
UNCERTAIN_LOWER_THRESHOLD=0.40
RECOGNITION_FPS=5
RECOGNITION_WIDTH=640
RECOGNITION_HEIGHT=360
JPEG_QUALITY=80
MAX_CAMERAS=16
MAX_WORKERS=4
FRAME_QUEUE_SIZE=2
CACHE_TTL_SECONDS=30
LOG_LEVEL=INFO
LOG_FORMAT=text
# Launcher overrides can be exported in your shell:
# BACKEND_PORT=8000 FRONTEND_PORT=5173 ATTEDDEL_VENV=.venv-attedel
# PostgreSQL example:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/attedel
